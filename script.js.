let clients = JSON.parse(localStorage.getItem("clients")) || [];
let projects = JSON.parse(localStorage.getItem("projects")) || [];

const inputs = document.querySelectorAll("input");
const buttons = document.querySelectorAll("button");

const saveClientBtn = buttons[6];
const saveProjectBtn = buttons[7];

function updateDashboard() {
  document.getElementById("clientsCount").textContent = clients.length;
  document.getElementById("projectsCount").textContent = projects.length;

  let revenue = 0;
  projects.forEach(p => revenue += Number(p.budget));
  document.getElementById("revenueCount").textContent = revenue;
}

updateDashboard();

saveClientBtn.onclick = function () {
  clients.push({
    name: inputs[0].value,
    phone: inputs[1].value,
    location: inputs[2].value
  });

  localStorage.setItem("clients", JSON.stringify(clients));
  updateDashboard();
  alert("Client saved!");
};

saveProjectBtn.onclick = function () {
  projects.push({
    name: inputs[3].value,
    location: inputs[4].value,
    budget: inputs[5].value
  });

  localStorage.setItem("projects", JSON.stringify(projects));
  updateDashboard();
  alert("Project saved!");
};
