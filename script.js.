let clients = JSON.parse(localStorage.getItem("clients")) || [];
let revenue = 0;

const inputs = document.querySelectorAll("input");
const saveClientBtn = document.querySelectorAll("button")[6];

function updateDashboard() {
  document.getElementById("clientsCount").textContent = clients.length;
  document.getElementById("revenueCount").textContent = revenue;
}

function showClients() {
  const list = document.querySelector("h3");
  list.innerHTML = "<b>Client List</b><br><br>";

  clients.forEach((client) => {
    list.innerHTML += `
      ${client.name}<br>
      📞 ${client.phone}<br>
      📍 ${client.location}<br><br>
    `;
  });
}

updateDashboard();
showClients();

saveClientBtn.onclick = function () {
  const name = inputs[0].value;
  const phone = inputs[1].value;
  const location = inputs[2].value;

  if (!name || !phone || !location) {
    alert("Fill all client details");
    return;
  }

  clients.push({ name, phone, location });
  localStorage.setItem("clients", JSON.stringify(clients));

  updateDashboard();
  showClients();

  inputs[0].value = "";
  inputs[1].value = "";
  inputs[2].value = "";

  alert("Client saved successfully!");
};
